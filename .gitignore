# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Database & Audio/Data Artifacts
# ==========================================
# Ignore SQLite database files generated in data/db/
data/db/*.db
data/db/*.sqlite
*.db
*.sqlite
*.sqlite3

# Ignore uploaded audio recordings or temporary audio caches
data/uploads/
*.wav
*.mp3
*.m4a
*.flac

# ==========================================
# Virtual Environments
# ==========================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ==========================================
# Streamlit & IDE Settings
# ==========================================
.streamlit/secrets.toml
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ==========================================
# Python Cache & Build Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/